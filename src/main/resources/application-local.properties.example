# Copy this file to application-local.properties and keep the copied file local.
# Activate it with: SPRING_PROFILES_ACTIVE=local
# Never commit real credentials. Replace every CHANGE_ME value locally.

# Server / frontend
server.port=8080
piggyback.cors.allowed-origins=http://localhost:5173,http://localhost:3000

# MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/piggyback?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

# Auth (local dev only - use a random long secret, never commit real values)
abuba.auth.jwt-secret=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
abuba.auth.expose-mock-code=true

# Google Gemini API for task classification and fraud guardrails.
# Prefer setting GEMINI_API_KEY in the environment. This local value is only a fallback.
piggyback.integrations.gemini.api-key=${GEMINI_API_KEY:CHANGE_ME_GEMINI_API_KEY}
piggyback.integrations.gemini.base-url=https://generativelanguage.googleapis.com/v1beta
piggyback.integrations.gemini.model=gemini-3.5-flash-lite
piggyback.integrations.gemini.connect-timeout=3s
piggyback.integrations.gemini.read-timeout=20s
piggyback.integrations.gemini.max-retries=1
piggyback.integrations.gemini.retry-delay=1s
# Application safety caps. The actual project quota shown in Google AI Studio remains authoritative.
piggyback.integrations.gemini.requests-per-minute=15
piggyback.integrations.gemini.requests-per-day=500
# Gemini RPD resets at midnight Pacific time.
piggyback.integrations.gemini.quota-zone=America/Los_Angeles

# NAVER Cloud CLOVA Speech Recognition (CSR) - short-form STT
# API headers: x-ncp-apigw-api-key-id and x-ncp-apigw-api-key
piggyback.integrations.clova-csr.endpoint=https://naveropenapi.apigw.ntruss.com/recog/v1/stt
piggyback.integrations.clova-csr.api-key-id=CHANGE_ME
piggyback.integrations.clova-csr.api-key=CHANGE_ME
piggyback.integrations.clova-csr.language=Kor
piggyback.integrations.clova-csr.connect-timeout=3s
piggyback.integrations.clova-csr.read-timeout=65s
piggyback.integrations.clova-csr.max-audio-size=3MB

# Financial Map - branch/ATM master data
piggyback.integrations.finmap.base-url=https://openapi.kftc.or.kr
piggyback.integrations.finmap.api-key=CHANGE_ME

# Seoul real-time city data
piggyback.integrations.seoul-city-data.base-url=http://openapi.seoul.go.kr:8088
piggyback.integrations.seoul-city-data.api-key=CHANGE_ME

# Road-name address / coordinate API
piggyback.integrations.juso.base-url=https://business.juso.go.kr/addrlink/addrCoordApi.do
piggyback.integrations.juso.confirmation-key=CHANGE_ME

# Recommendation tuning - confirmed defaults.
piggyback.recommendation.distance-weight=0.4
piggyback.recommendation.waiting-weight=0.6
piggyback.recommendation.result-limit=3
piggyback.recommendation.congestion-ttl=10m
piggyback.recommendation.search-radius-km=10
piggyback.recommendation.default-wait-minutes=15
piggyback.recommendation.planning-business-days=2

# Classification tuning
piggyback.classification.confidence-threshold=0.75
piggyback.classification.candidate-floor=0.35
piggyback.classification.candidate-limit=3

# Local diagnostics
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
logging.level.com.piggyback.backend=DEBUG
